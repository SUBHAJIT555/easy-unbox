DirectoryIndex index.html index.htm
Options -MultiViews +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^api/submit/?$ api/submit.php [L]

  RewriteRule ^cart/?$ cart.html [L]
  RewriteRule ^checkout/?$ checkout.html [L]
  RewriteRule ^shop/?$ shop.html [L]
  RewriteRule ^wishlist/?$ wishlist.html [L]
  RewriteRule ^contact/?$ contact.html [L]
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^faq/?$ faq.html [L]
  RewriteRule ^mail-success/?$ mail-success.html [L]
  RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
  RewriteRule ^cookie-policy/?$ cookie-policy.html [L]
  RewriteRule ^terms-and-conditions/?$ terms-and-conditions.html [L]
  RewriteRule ^return-policy/?$ return-policy.html [L]
  RewriteRule ^coupon/?$ coupon.html [L]
  RewriteRule ^shop-category/?$ shop-category.html [L]
  RewriteRule ^shop-right-sidebar/?$ shop-right-sidebar.html [L]
  RewriteRule ^shop-hidden-sidebar/?$ shop-hidden-sidebar.html [L]
  RewriteRule ^home-2/?$ home-2.html [L]
  RewriteRule ^home-3/?$ home-3.html [L]
  RewriteRule ^home-4/?$ home-4.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^.]+)/?$ $1.html [L]
</IfModule>

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
