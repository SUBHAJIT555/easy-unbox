# Copy this file to public_html/.env on the server (do not commit real passwords).
# Leave SMTP_HOST empty to use cPanel PHP mail(). Create mailbox info@easy-unbox.com first.

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASS=

MAIL_FROM=info@easy-unbox.com
MAIL_FROM_NAME=Easy Unbox
MAIL_TO=info@easy-unbox.com
MAIL_TO_NAME=Easy Unbox
