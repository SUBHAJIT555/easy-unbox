# Visual brand theme
NEXT_PUBLIC_SITE_THEME=easy-unbox
SITE_NUMBER=13
NEXT_PUBLIC_SITE_NUMBER=13

# Same-origin PHP mailer (production). Leave unset to use /api/submit.php
# NEXT_PUBLIC_SUBMIT_API_URL=https://easy-unbox.com/api/submit.php

# Optional SMTP. Leave SMTP_HOST empty to use cPanel PHP mail()
# (create mailbox info@easy-unbox.com in cPanel first).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASS=

MAIL_FROM=info@easy-unbox.com
MAIL_FROM_NAME=Easy Unbox
MAIL_TO=info@easy-unbox.com
MAIL_TO_NAME=Easy Unbox
